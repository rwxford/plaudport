# Base origin + path prefix of the Plaud web API (capture from DevTools; see docs/ENDPOINTS.md)
PLAUD_API_BASE=

# Bearer token captured from web.plaud.ai (KEEP SECRET; do not commit a filled .env)
PLAUD_TOKEN=

# Optional extra headers as JSON (e.g. {"x-workspace-id":"..."} ) if the API requires them
PLAUD_EXTRA_HEADERS=

# Set to "true" only when intentionally running the guarded M0 write test
PLAUD_ALLOW_WRITE_TEST=false
