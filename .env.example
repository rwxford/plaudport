# PlaudPort configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. This file is the only env
# file that belongs in the repo, and it must never contain a real value.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Base origin + path prefix of the Plaud web API.
# Capture it from DevTools — see docs/ENDPOINTS.md.
# Example shape (NOT a real endpoint): https://api.plaud.ai/v1
PLAUD_API_BASE=

# Bearer token captured from web.plaud.ai. SECRET — treat it like a password.
# It grants full access to your Plaud account for months. Never paste it into
# an issue, PR, log, or screenshot.
PLAUD_TOKEN=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Extra request headers as JSON, if your account needs them (see docs/ENDPOINTS.md).
# Example shape: {"x-workspace-id":"..."}
PLAUD_EXTRA_HEADERS=

# Comma-separated hosts the client is allowed to contact (SSRF guard).
# PLAUD_API_BASE must resolve to one of these.
PLAUD_ALLOWED_HOSTS=web.plaud.ai,api.plaud.ai

# Where backups, the ledger, and run reports are written. Gitignored.
PLAUD_DATA_DIR=./data

# Per-request timeout in milliseconds.
PLAUD_REQUEST_TIMEOUT_MS=30000

# Redact string values out of API samples in spike-report.json.
# Keys and value shapes are kept, so you can still map endpoints — but no
# transcript text, names, or titles land on disk. Set to "false" ONLY for local
# debugging, and never share the resulting report.
PLAUD_REDACT_SAMPLES=true

# Set to "true" only when intentionally running the guarded M0 write test.
PLAUD_ALLOW_WRITE_TEST=false

# ---------------------------------------------------------------------------
# Reserved for later milestones (not read yet — see docs/PRD.md §9)
# ---------------------------------------------------------------------------
# PLAUDPORT_HOST=127.0.0.1     # M4 local web UI bind address; keep it loopback
# PLAUDPORT_PORT=4317          # M4 local web UI port
# PLAUD_CONCURRENCY=3          # M1/M2 parallel download/upload workers
# PLAUD_BACKUP_MAX_AGE_HOURS=24  # M1 skip-if-current freshness window
