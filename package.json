{
  "name": "plaudport",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first tool to import shared Plaud meetings into your Personal workspace, and to back up and consolidate your own Plaud recordings.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "spike": "tsx src/spike.ts",
    "scan:har": "tsx src/harScan.ts",
    "scan:upload": "tsx src/uploadScan.ts",
    "probe:share": "tsx src/shareProbe.ts",
    "fetch:share": "tsx src/shareFetch.ts",
    "fetch:audio": "tsx src/fetchAudio.ts",
    "import:audio": "tsx src/importAudio.ts",
    "check:auth": "tsx src/checkAuth.ts",
    "set:auth": "tsx src/setAuth.ts",
    "test": "tsx --test src/*.test.ts",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc --noEmit",
    "check:secrets": "bash scripts/check-no-secrets.sh",
    "hooks:install": "bash scripts/install-hooks.sh"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
