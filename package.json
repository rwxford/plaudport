{
  "name": "plaudport",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first tool to back up Plaud data and copy Personal-workspace recordings into a Team workspace.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "spike": "tsx src/spike.ts",
    "scan:har": "tsx src/harScan.ts",
    "typecheck": "tsc --noEmit",
    "check:secrets": "bash scripts/check-no-secrets.sh",
    "hooks:install": "bash scripts/install-hooks.sh"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
