{
  "manifest_version": 3,
  "name": "PlaudPort credential sync",
  "version": "0.1.1",
  "description": "Keep local PlaudPort credentials current from your signed-in Plaud session.",
  "key": "",
  "permissions": [
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://web.plaud.ai/*",
    "https://api.plaud.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PlaudPort: open Plaud to sync credentials",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
